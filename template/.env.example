# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Affiliate offer. Use {subid} where the network wants your sub-ID.
OFFER_URL=https://network.com/click?offer=123&aff=456&sub1={subid}
NETWORK_NAME=

# REQUIRED. Shared secret for the postback URL. /api/pb refuses every postback
# with 503 until this is set — an open postback endpoint lets anyone forge
# conversions and train Meta to buy their traffic with your budget.
#   openssl rand -hex 24
POSTBACK_SECRET=

# Meta Conversions API — this is what makes Meta optimise on real revenue
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# Landing page split test, comma separated. Each value needs a matching key in
# window.VARIANTS inside lp/<slug>/index.html, or that arm serves the control.
LP_VARIANTS=a,b
