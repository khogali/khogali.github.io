# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# ---- Offers -------------------------------------------------------------
# One deploy, one burner domain per offer. OFFERS maps hostname -> offer, so a
# flagged domain takes only its own offer down. Vercel allows 50 domains per
# project, so this needs one project, not one per offer.
# {subid} is replaced with the click_id. On ClickBank put it in aff_sub1:
# that field allows 100 chars including hyphens, so a UUID fits. Legacy tid
# does not.
# LIVE VALUE. Affiliate nickname ashilkawi, vendor nickname otppurisak, both
# confirmed from inside the ClickBank account. Paste as one line.
#
# BLOCKER: as of 2026-09-01 this hoplink returns errCode=accntstate, meaning
# ClickBank will not issue a tracked hop from this account. The visitor still
# reaches the offer, so it looks like it works, but no sale can be credited.
# Resolve with ClickBank support BEFORE spending. Verify with:
#   curl -sk -L -o /dev/null -w '%{url_effective}\n' \
#     https://ashilkawi.otppurisak.hop.clickbank.net/
# A working hop lands on buy-purisaki.com with no errCode in the URL.
OFFERS={"thecravingsnote.com":{"name":"purisaki","url":"https://ashilkawi.otppurisak.hop.clickbank.net/?aff_sub1={subid}&traffic_source=meta&traffic_type=paid"}}

# Single-offer fallback, used when OFFERS is absent or the host is not in it.
OFFER_URL=
OFFER_NAME=
NETWORK_NAME=

# REQUIRED. Shared secret for the postback URL. /api/pb refuses every postback
# with 503 until this is set — an open postback endpoint lets anyone forge
# conversions and train Meta to buy their traffic with your budget.
#   openssl rand -hex 24
POSTBACK_SECRET=

# Meta Conversions API — this is what makes Meta optimise on real revenue
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# Landing page split test, comma separated. Each value needs a matching key in
# window.VARIANTS inside lp/<slug>/index.html, or that arm serves the control.
LP_VARIANTS=a,b
