{
  "manifest_version": 3,
  "name": "Mudroom",
  "version": "0.1.0",
  "description": "Nothing enters your filesystem with its shoes on. Downloads stop at the door, get a name and a room, or sit on the mat until you deal with them.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Mudroom",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["downloads", "storage", "alarms", "notifications", "nativeMessaging"],
  "browser_specific_settings": {
    "safari": { "strict_min_version": "16.4" }
  }
}
