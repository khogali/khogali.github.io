# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Affiliate offer. Use {subid} where the network wants your sub-ID.
OFFER_URL=https://network.com/click?offer=123&aff=456&sub1={subid}
NETWORK_NAME=

# Shared secret for the postback URL (prevents forged conversions)
POSTBACK_SECRET=

# Meta Conversions API — this is what makes Meta optimise on real revenue
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# Landing page split test, comma separated
LP_VARIANTS=a,b
